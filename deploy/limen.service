# /etc/systemd/system/limen.service  (native install, without Docker)
# Adjust User and the paths; create the venv first (see docs/DEVELOPMENT.md).
[Unit]
Description=Limen master
After=network-online.target
Wants=network-online.target

[Service]
User=limen
WorkingDirectory=/opt/limen/backend
ExecStart=/opt/limen/backend/avvia.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
