# Copy this file to .env (in the backend/ folder) and fill it in. .env is not versioned.

# Key that signs the session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Without it the server creates a temporary one at every start, logging everyone out at each restart.
# (With Docker this is automatic: the key is created once in the data volume.)
SESSION_SECRET=

# Folder for the database, certificates and session key (default: the backend/ folder; /data in Docker).
# LIMEN_DATA=

# Time zone for logs and time windows (default Europe/Rome).
# TIMEZONE=Europe/Rome
